# Database
POSTGRES_URL=

# SMS.ir (Iranian SMS provider)
# Get these from your SMS.ir developer panel.
SMS_IR_API_KEY=your_sms_ir_api_key
SMS_IR_TEMPLATE_ID=your_template_id
# SMS.ir /verify endpoint uses the service line configured in your panel,
# so a sender number is not required. Keep it here for reference/other endpoints.
SMS_IR_SENDER_NUMBER=+98XXXXXXXXXX

# Optional: use "console" to log OTPs locally instead of sending real SMS
# SMS_PROVIDER=console

# NextAuth / Google (if used)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_SECRET=
