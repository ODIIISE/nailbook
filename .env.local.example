# Database
POSTGRES_URL=

# Multi-tenant mode: the salon this deployment serves (UUID or slug).
# Leave unset only for the super-admin platform deployment.
SALON_ID=

# Session secrets (HMAC cookie signing) — required
OWNER_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=
SUPER_ADMIN_SESSION_SECRET=

# Required in production for one-time bootstrap routes
BOOTSTRAP_OWNER_SECRET=
BOOTSTRAP_SUPER_ADMIN_SECRET=

# SMS provider — the app sends OTPs via FarazSMS.
# Get these from the FarazSMS (iplinksms.ir) panel: API key, sender line, and
# the verification pattern (template) code. FARAZSMS_PATTERN_VAR is the
# variable name inside the pattern that receives the OTP code (default var1).
FARAZSMS_API_KEY=
FARAZSMS_LINE_NUMBER=
FARAZSMS_PATTERN_CODE=
FARAZSMS_PATTERN_VAR=var1

# Optional: use "console" to log OTPs instead of sending real SMS.
# In production, missing FarazSMS credentials FAIL the send (no silent
# fallback) unless SMS_PROVIDER=console is set explicitly.
# SMS_PROVIDER=console

# Optional: log raw SMS provider requests/responses (contains phone numbers —
# never enable in production). Also lets console OTPs run in production.
# DEBUG_SMS=true

# Public origin used for metadata/OG URLs (defaults to the deployed URL).
# NEXT_PUBLIC_APP_URL=https://forehand.vercel.app

# Image storage (Vercel Blob) — auto-injected by Vercel when Blob is enabled.
BLOB_READ_WRITE_TOKEN=
